# Copy to .env.production. All values but WORKOS_API_KEY are public. The file is gitignored.
CLOUDFLARE_ACCOUNT_ID=
CLOUD_WORKER_NAME=origin89-cloud-production
CLOUD_HOSTNAME=
CLOUD_DATABASE_NAME=origin89-cloud-production
CLOUD_DATABASE_ID=
WORKOS_CLIENT_ID=client_01M3CC0Q23FPHK50YW1WXCNZ3S
# The iss of an access token; https://api.workos.com until a custom AuthKit domain is set.
WORKOS_ISSUER=https://api.workos.com
# The WorkOS API key. just deploy uploads it as a Worker secret; it is never written to
# wrangler.deploy.json. Leave it empty to keep the secret already on the Worker.
WORKOS_API_KEY=
