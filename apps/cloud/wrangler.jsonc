{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "origin89-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  // WORKOS_CLIENT_ID, WORKOS_ISSUER and WORKOS_AUDIENCE come from .dev.vars locally and from
  // scripts/deployment-config.mjs on deploy. WORKOS_API_KEY is a Worker secret.
  "d1_databases": [
    { "binding": "DB", "database_name": "origin89-cloud", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
