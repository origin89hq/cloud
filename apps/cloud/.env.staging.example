# Copy to .env.staging. All values but WORKOS_API_KEY are public. The file is gitignored.
CLOUDFLARE_ACCOUNT_ID=
CLOUD_WORKER_NAME=origin89-cloud-staging
CLOUD_HOSTNAME=
CLOUD_DATABASE_NAME=origin89-cloud-staging
CLOUD_DATABASE_ID=
WORKOS_CLIENT_ID=client_01M3C9M944Y53VA9PJRCW8T5S6
# The iss of a staging access token, copied from a decoded token.
WORKOS_ISSUER=
# The aud the staging JWT template adds; see DEPLOYMENT.md.
WORKOS_AUDIENCE=
# The WorkOS API key. just deploy uploads it as a Worker secret; it is never written to
# wrangler.deploy.json. Leave it empty to keep the secret already on the Worker.
WORKOS_API_KEY=
